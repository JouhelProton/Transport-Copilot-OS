# Copia este archivo como .env cuando GEStracking facilite el acceso de integración.
# Nunca compartas ni publiques el valor del token.

# URL HTTPS de consulta de posición, con uno o ambos marcadores admitidos.
# Ejemplo de formato (NO es un endpoint real de GEStracking):
# GESTRACKING_TRACKING_URL_TEMPLATE=https://api.proveedor.example/vehicles/{vehicleId}/position

# Credenciales y autenticación según documentación de GEStracking.
# GESTRACKING_API_TOKEN=
# GESTRACKING_AUTH_HEADER=Authorization
# GESTRACKING_AUTH_PREFIX=Bearer

# Mapeo JSON (JSONPath simplificado con rutas separadas por puntos) del JSON de respuesta.
# Configura únicamente con el ejemplo real del proveedor.
# GESTRACKING_RESPONSE_MAP={"latitude":"position.latitude","longitude":"position.longitude","location":"position.address","temperature":"temperature.value","eta":"trip.eta","status":"trip.status","updatedAt":"position.timestamp"}

# Recepción del correo por un webhook seguro configurado en Gmail/Outlook/servicio de email.
# GESTRACKING_EMAIL_WEBHOOK_SECRET=
# GESTRACKING_EMAIL_ALLOWED_DOMAINS=gestracking.com
# GESTRACKING_EMAIL_LINK_DOMAINS=gestracking.com

# Clave de Google Maps Embed API para el mapa integrado (geográfico/satélite).
# Habilita Maps Embed API y la facturación del proyecto; el uso de Embed es gratuito.
# Restringe por HTTP referrer al dominio (y localhost durante desarrollo) y por API.
# La clave se usa en el navegador; no uses una clave sin restricciones.
# GOOGLE_MAPS_EMBED_API_KEY=
