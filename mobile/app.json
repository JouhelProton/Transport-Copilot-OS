{
  "expo": {
    "name": "NEXO Driver",
    "slug": "transport-copilot-driver",
    "version": "0.3.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "transportcopilot",
    "userInterfaceStyle": "light",
    "primaryColor": "#3157D5",
    "ios": {
      "bundleIdentifier": "com.transportcopilot.driver",
      "supportsTablet": false,
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.transportcopilot.driver",
      "adaptiveIcon": {
        "backgroundColor": "#EAF0FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "NEXO Driver necesita acceder a la imagen seleccionada para adjuntarla como prueba de entrega.",
          "cameraPermission": "NEXO Driver necesita usar la cámara cuando decides fotografiar una prueba de entrega."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141C3A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NEXO necesita tu ubicación mientras el seguimiento del servicio esté activo."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
