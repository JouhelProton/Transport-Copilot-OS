# PostgreSQL local para desarrollo. No reutilizar estas credenciales en producción.
DATABASE_URL=postgresql://transport_copilot:transport_copilot_dev@127.0.0.1:5434/transport_copilot?schema=public
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=15000
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info
CORS_ORIGIN=http://127.0.0.1:4176
# Orígenes internos por defecto de Capacitor. No añadir comodines.
MOBILE_CORS_ORIGINS=capacitor://localhost,https://localhost
NODE_ENV=development
SESSION_COOKIE_NAME=transport_copilot_session
SESSION_TTL_HOURS=8
# Clave de servidor restringida a Routes API. No reutilizar la clave web de Maps.
GOOGLE_ROUTES_API_KEY=
ETA_REFRESH_MINUTES=5
ETA_MOVEMENT_METERS=5000
GPS_STALE_MINUTES=5
NO_PROGRESS_MINUTES=20
DELAY_CONFIRMED_MINUTES=30
GEOFENCE_RADIUS_METERS=250
GEOFENCE_MAX_ACCURACY_METERS=100
# Directorio privado local; nunca exponerlo como contenido estático.
DOCUMENT_STORAGE_ROOT=.local-data/documents
DOCUMENT_MAX_BYTES=10485760
