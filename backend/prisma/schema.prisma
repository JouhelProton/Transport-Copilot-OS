generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationKind {
  CARRIER
  SHIPPER
}

enum Role {
  SUPER_ADMIN
  TRANSPORT_ADMIN
  DISPATCHER
  OPERATIONS
  ACCOUNTING
  DRIVER
  CUSTOMER
}

enum OrderStatus {
  SUBMITTED
  ACCEPTED
}

enum ServiceStatus {
  PLANNED
  ASSIGNED
  DRIVER_ACCEPTED
}

enum AssignmentStatus {
  ACTIVE
  REPLACED
}

enum DriverStatus {
  ACTIVE
  RESTING
}

enum VehicleStatus {
  AVAILABLE
  IN_SERVICE
  MAINTENANCE
}

enum ServiceEventType {
  ORDER_CREATED
  ORDER_ACCEPTED
  SERVICE_CREATED
  DRIVER_ASSIGNED
  VEHICLE_ASSIGNED
  DRIVER_ACCEPTED
  TRACKING_STARTED
  TRACKING_STOPPED
  TRACKING_EXPIRED
  ETA_UPDATED
  DELAY_STATUS_CHANGED
  GEOFENCE_ENTERED
  GEOFENCE_EXITED
  INCIDENT_CREATED
  INCIDENT_UPDATED
}

enum TrackingSessionStatus {
  ACTIVE
  STOPPED
  EXPIRED
}

enum EtaStatus {
  AVAILABLE
  UNAVAILABLE
}

enum DelayLevel {
  ON_TIME
  RISK
  CONFIRMED
  DATA_INSUFFICIENT
}

enum GeofenceKind {
  ORIGIN
  DESTINATION
}

enum GeofenceEventKind {
  ENTERED
  EXITED
}

enum IncidentType {
  DELAY
  BREAKDOWN
  LOADING_PROBLEM
  UNLOADING_PROBLEM
  WRONG_ADDRESS
  DOCUMENT_PROBLEM
  OTHER
}

enum IncidentStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  DELAY_DETECTED
  INCIDENT_CREATED
  ARRIVAL_DETECTED
  GPS_STALE
}

model Organization {
  id                     String            @id
  name                   String
  kind                   OrganizationKind
  memberships            Membership[]
  customers              Customer[]        @relation("CarrierCustomers")
  customerRepresentation Customer[]        @relation("CustomerOrganization")
  ownedOrders            Order[]           @relation("OrderOwner")
  carrierOrders          Order[]           @relation("OrderCarrier")
  services               Service[]         @relation("ServiceCarrier")
  customerServices       Service[]         @relation("ServiceCustomer")
  drivers                Driver[]
  vehicles               Vehicle[]
  assignments            Assignment[]
  events                 ServiceEvent[]
  auditLogs              AuditLog[]
  trackingSessions       TrackingSession[]
  currentPositions       CurrentPosition[]
  locationHistory        LocationHistory[]
  etaEstimates           EtaEstimate[]
  operationalStates      ServiceOperationalState[]
  geofences              ServiceGeofence[]
  geofenceEvents         GeofenceEvent[]
  incidents              OperationalIncident[]
  incidentHistory        IncidentHistory[]
  notifications          InternalNotification[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

model User {
  id            String       @id
  email         String       @unique
  name          String
  passwordHash  String
  memberships   Membership[]
  sessions      Session[]
  customer      Customer?
  driver        Driver?
  createdOrders Order[]      @relation("OrderCreator")
  auditLogs     AuditLog[]
  reportedIncidents OperationalIncident[] @relation("IncidentReporter")
  incidentChanges  IncidentHistory[]       @relation("IncidentChanger")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           Role
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions       Session[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId, organizationId])
}

model Session {
  id                  String     @id @default(cuid())
  userId              String
  currentMembershipId String
  tokenHash           String     @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime   @default(now())
  lastUsedAt          DateTime   @default(now())
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentMembership   Membership @relation(fields: [currentMembershipId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([currentMembershipId])
}

model Customer {
  id                     String       @id
  organizationId         String
  customerOrganizationId String
  userId                 String?      @unique
  name                   String
  contact                String
  organization           Organization @relation("CarrierCustomers", fields: [organizationId], references: [id], onDelete: Restrict)
  customerOrganization   Organization @relation("CustomerOrganization", fields: [customerOrganizationId], references: [id], onDelete: Restrict)
  user                   User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders                 Order[]
  services               Service[]
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@unique([organizationId, customerOrganizationId])
  @@index([customerOrganizationId])
}

model Order {
  id                    String         @id @default(cuid())
  organizationId        String
  carrierOrganizationId String
  customerId            String
  createdByUserId       String
  reference             String
  originName            String
  originAddress         String
  originLat             Decimal        @db.Decimal(9, 6)
  originLng             Decimal        @db.Decimal(9, 6)
  destinationName       String
  destinationAddress    String
  destinationLat        Decimal        @db.Decimal(9, 6)
  destinationLng        Decimal        @db.Decimal(9, 6)
  cargo                 String
  pallets               Int
  tempMin               Decimal?       @db.Decimal(5, 2)
  tempMax               Decimal?       @db.Decimal(5, 2)
  plannedPickup         DateTime
  plannedDelivery       DateTime
  status                OrderStatus    @default(SUBMITTED)
  acceptedAt            DateTime?
  organization          Organization   @relation("OrderOwner", fields: [organizationId], references: [id], onDelete: Restrict)
  carrierOrganization   Organization   @relation("OrderCarrier", fields: [carrierOrganizationId], references: [id], onDelete: Restrict)
  customer              Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy             User           @relation("OrderCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  service               Service?
  events                ServiceEvent[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([organizationId, reference])
  @@index([carrierOrganizationId, status])
  @@index([customerId, createdAt])
}

model Service {
  id                     String            @id @default(cuid())
  organizationId         String
  customerOrganizationId String
  customerId             String
  orderId                String            @unique
  status                 ServiceStatus     @default(PLANNED)
  organization           Organization      @relation("ServiceCarrier", fields: [organizationId], references: [id], onDelete: Restrict)
  customerOrganization   Organization      @relation("ServiceCustomer", fields: [customerOrganizationId], references: [id], onDelete: Restrict)
  customer               Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order                  Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  assignments            Assignment[]
  events                 ServiceEvent[]
  trackingSessions       TrackingSession[]
  currentPosition        CurrentPosition?  @relation("ServiceCurrentPosition")
  locationHistory        LocationHistory[] @relation("ServiceLocationHistory")
  etaEstimate            EtaEstimate?
  operationalState       ServiceOperationalState?
  geofences              ServiceGeofence[]
  geofenceEvents         GeofenceEvent[]
  incidents              OperationalIncident[]
  notifications          InternalNotification[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([organizationId, status])
  @@index([customerOrganizationId, createdAt])
}

model Driver {
  id               String            @id
  organizationId   String
  userId           String?           @unique
  name             String
  phone            String
  license          String
  status           DriverStatus      @default(ACTIVE)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments      Assignment[]
  trackingSessions TrackingSession[]
  currentPositions CurrentPosition[]
  locationHistory  LocationHistory[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([organizationId, status])
}

model Vehicle {
  id             String        @id
  organizationId String
  plate          String
  type           String
  reefer         Boolean       @default(false)
  status         VehicleStatus @default(AVAILABLE)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments    Assignment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, plate])
  @@index([organizationId, status])
}

model Assignment {
  id               String           @id @default(cuid())
  organizationId   String
  serviceId        String
  driverId         String
  vehicleId        String
  status           AssignmentStatus @default(ACTIVE)
  assignedByUserId String
  assignedAt       DateTime         @default(now())
  acceptedAt       DateTime?
  endedAt          DateTime?
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service          Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  driver           Driver           @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle          Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([organizationId, serviceId, status])
  @@index([driverId, status])
  @@index([vehicleId, status])
}

model TrackingSession {
  id             String                @id @default(cuid())
  organizationId String
  serviceId      String
  driverId       String
  status         TrackingSessionStatus @default(ACTIVE)
  startedAt      DateTime              @default(now())
  stoppedAt      DateTime?
  stopReason     String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service        Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  driver         Driver                @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([organizationId, serviceId, status])
  @@index([driverId, status])
}

model CurrentPosition {
  id             String       @id @default(cuid())
  organizationId String
  serviceId      String       @unique
  driverId       String
  latitude       Decimal      @db.Decimal(9, 6)
  longitude      Decimal      @db.Decimal(9, 6)
  accuracy       Decimal      @db.Decimal(7, 2)
  heading        Decimal?     @db.Decimal(6, 2)
  speed          Decimal?     @db.Decimal(8, 2)
  recordedAt     DateTime
  receivedAt     DateTime     @default(now())
  source         String       @default("MOBILE_GPS")
  sampleId       String
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service        Service      @relation("ServiceCurrentPosition", fields: [serviceId], references: [id], onDelete: Restrict)
  driver         Driver       @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@unique([organizationId, serviceId])
  @@index([organizationId, recordedAt])
  @@index([driverId, recordedAt])
}

model LocationHistory {
  id             String       @id @default(cuid())
  organizationId String
  serviceId      String
  driverId       String
  latitude       Decimal      @db.Decimal(9, 6)
  longitude      Decimal      @db.Decimal(9, 6)
  accuracy       Decimal      @db.Decimal(7, 2)
  heading        Decimal?     @db.Decimal(6, 2)
  speed          Decimal?     @db.Decimal(8, 2)
  recordedAt     DateTime
  receivedAt     DateTime     @default(now())
  source         String       @default("MOBILE_GPS")
  sampleId       String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service        Service      @relation("ServiceLocationHistory", fields: [serviceId], references: [id], onDelete: Restrict)
  driver         Driver       @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@unique([serviceId, sampleId])
  @@index([organizationId, serviceId, recordedAt])
  @@index([driverId, recordedAt])
}

model EtaEstimate {
  id              String       @id @default(cuid())
  organizationId  String
  serviceId       String       @unique
  status          EtaStatus
  estimatedArrival DateTime?
  durationSeconds Int?
  distanceMeters  Int?
  calculatedAt    DateTime
  source          String
  unavailableReason String?
  originLat       Decimal?     @db.Decimal(9, 6)
  originLng       Decimal?     @db.Decimal(9, 6)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service         Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, calculatedAt])
}

model ServiceOperationalState {
  id              String       @id @default(cuid())
  organizationId  String
  serviceId       String       @unique
  delayLevel      DelayLevel   @default(DATA_INSUFFICIENT)
  delayMinutes    Int?
  gpsStale        Boolean      @default(false)
  noProgress      Boolean      @default(false)
  reasons         Json
  assessedAt      DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service         Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([organizationId, delayLevel, gpsStale])
}

model ServiceGeofence {
  id              String        @id @default(cuid())
  organizationId  String
  serviceId       String
  kind            GeofenceKind
  latitude        Decimal       @db.Decimal(9, 6)
  longitude       Decimal       @db.Decimal(9, 6)
  radiusMeters    Int           @default(250)
  isInside        Boolean       @default(false)
  lastTransitionAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service         Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  events          GeofenceEvent[]

  @@unique([serviceId, kind])
  @@index([organizationId, kind])
}

model GeofenceEvent {
  id              String             @id @default(cuid())
  organizationId  String
  serviceId       String
  geofenceId      String
  kind            GeofenceEventKind
  latitude        Decimal            @db.Decimal(9, 6)
  longitude       Decimal            @db.Decimal(9, 6)
  accuracy        Decimal            @db.Decimal(7, 2)
  distanceMeters  Int
  recordedAt      DateTime
  createdAt       DateTime           @default(now())
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service         Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  geofence        ServiceGeofence    @relation(fields: [geofenceId], references: [id], onDelete: Restrict)

  @@index([organizationId, serviceId, recordedAt])
  @@index([geofenceId, recordedAt])
}

model OperationalIncident {
  id              String             @id @default(cuid())
  organizationId  String
  serviceId       String
  type            IncidentType
  description     String
  status          IncidentStatus     @default(OPEN)
  priority        IncidentPriority   @default(MEDIUM)
  reportedByUserId String
  reportedAt      DateTime           @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service         Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  reportedBy      User               @relation("IncidentReporter", fields: [reportedByUserId], references: [id], onDelete: Restrict)
  history         IncidentHistory[]

  @@index([organizationId, status, priority])
  @@index([serviceId, reportedAt])
}

model IncidentHistory {
  id              String              @id @default(cuid())
  organizationId  String
  incidentId      String
  changedByUserId String
  fromStatus      IncidentStatus?
  toStatus        IncidentStatus
  note            String?
  changedAt       DateTime            @default(now())
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  incident        OperationalIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  changedBy       User                @relation("IncidentChanger", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, incidentId, changedAt])
}

model InternalNotification {
  id              String           @id @default(cuid())
  organizationId  String
  serviceId       String?
  type            NotificationType
  title           String
  message         String
  dedupeKey       String
  readAt          DateTime?
  createdAt       DateTime         @default(now())
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service         Service?         @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, readAt, createdAt])
}

model ServiceEvent {
  id             String           @id @default(cuid())
  organizationId String
  serviceId      String?
  orderId        String?
  type           ServiceEventType
  entityType     String
  entityId       String
  actorUserId    String?
  correlationId  String
  schemaVersion  Int              @default(1)
  payload        Json
  occurredAt     DateTime         @default(now())
  recordedAt     DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service        Service?         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  order          Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([serviceId, occurredAt])
  @@index([orderId, occurredAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  outcome        String       @default("SUCCESS")
  requestId      String
  metadata       Json
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}
